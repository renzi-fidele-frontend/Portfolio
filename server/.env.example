# Porta do servidor Express
PORT=4000

# Ambiente: development | production
NODE_ENV=development

# String de conexao do MongoDB (local ou Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio-cms

# Segredo usado para assinar os tokens JWT (use algo longo e aleatorio)
JWT_SECRET=troque-isto-por-uma-string-longa-e-aleatoria
JWT_EXPIRA_EM=7d

# Origens autorizadas a chamar a API, separadas por virgula
ORIGENS_PERMITIDAS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174

# Credenciais do Cloudinary (painel > Dashboard)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_PASTA=portfolio-cms

# Usados apenas pelo script npm run criar-admin
ADMIN_NOME=Renzi Fidele
ADMIN_EMAIL=
ADMIN_SENHA=
